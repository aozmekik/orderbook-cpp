---
# Strict static analysis; every remaining warning is an error.
# Disabled checks and why:
#   *-magic-numbers                 : constants such as 64 (bits per word) read better inline
#   readability-identifier-length   : `i`, `it`, `id` are idiomatic
#   modernize-use-trailing-return-type, readability-trailing-comma : style only
#   modernize-use-designated-initializers : positional init of small strongly typed
#                                     aggregates (Price, Qty, ids) cannot mix up fields
#   bugprone-easily-swappable-parameters : prices and quantities already have distinct types
#   cppcoreguidelines-pro-bounds-pointer-arithmetic : needed for from_chars/to_chars ranges
#   cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
#   cppcoreguidelines-pro-bounds-constant-array-index : the hot path indexes pools and rings
#                                     with indices it validated; .at() would add a branch and
#                                     an exception path (bounds are asserted in debug builds)
#   portability-avoid-pragma-once   : every supported compiler implements it
#   misc-include-cleaner            : disagrees with the standard library's own layout
# bugprone-exception-escape ignores allocation failures, which are fatal by design (the
# hot path is noexcept and running out of memory calls std::terminate), and the
# logic_error family (out_of_range, length_error, bad_variant_access), which would only
# signal a violated precondition that the tests and sanitizers rule out.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  misc-*,
  -misc-include-cleaner,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-designated-initializers,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-trailing-comma,
  -readability-identifier-length,
  -readability-magic-numbers
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include/orderbook|src|apps|bench|tests|fuzz|examples)/.*'
FormatStyle: file
CheckOptions:
  - key: bugprone-exception-escape.IgnoredExceptions
    value: 'bad_alloc,bad_array_new_length,length_error,out_of_range,bad_variant_access'
  - key: bugprone-suspicious-stringview-data-usage.AllowedCallees
    value: '::std::from_chars'
  - key: cppcoreguidelines-macro-usage.AllowedRegexp
    value: '^OB_'
  - key: readability-function-cognitive-complexity.Threshold
    value: 40
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: true
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: lower_case
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^(BM_[A-Za-z]+|LLVMFuzzerTestOneInput|PrintTo)$'
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: _
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasIgnoredRegexp
    value: '^(rep|value_type|error_type|book_type|is_transparent|expected|unexpected)$'
...
