/// @file
/// Build configuration of the library, generated by CMake from
/// `include/orderbook/config.hpp.in`. Do not edit; reconfigure instead.
///
/// These settings change types that the compiled library exposes, so they
/// are fixed when the library is built and recorded here. They never depend
/// on the language mode of the translation unit that includes the headers.

#pragma once

/// 1 if `ob::expected` is `std::expected`, 0 if it is the library's own
/// fallback. Set with the CMake option `OB_USE_STD_EXPECTED` (default OFF),
/// which also makes C++23 a usage requirement of the library.
#define OB_USE_STD_EXPECTED @OB_USE_STD_EXPECTED_VALUE@
